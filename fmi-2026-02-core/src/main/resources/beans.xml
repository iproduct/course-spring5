<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:p="http://www.springframework.org/schema/p"
       xmlns:c="http://www.springframework.org/schema/c"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd">
    <context:property-placeholder location="classpath:article.properties"/>
    <bean id="longIdGen" class="course.spring.dao.impl.IdGeneratorLong"
        c:initialId="${initialGeneratedId}">
<!--        <constructor-arg name="initialId" value="1000"/>-->
<!--            <value>1000</value>-->
<!--        </constructor-arg>-->
    </bean>
    <bean id="articleRepoInMemory" class="course.spring.dao.impl.ArticleRepositoryInMemory"
          c:idGen-ref="longIdGen" />
    <bean id="articleProviderInMemory" class="course.spring.service.impl.ArticleProviderInMemory"
          init-method="init" c:articlesRepo-ref="articleRepoInMemory" />
    <bean id="articleProviderFromProperties" class="course.spring.service.impl.ArticleProviderFromProperties"
          p:articleTitles="${articles.titles}">
<!--        <property name="articleTitles" value="${articles.titles}" />-->
<!--            <value>Arfticle A, Article B, Article C</value>-->
<!--        </property>-->
    </bean>
    <bean id="presenter" scope="singleton" class="course.spring.client.impl.ArticlePreseterImpl"
        p:provider-ref="articleProviderInMemory" />
<!--        <property name="provider">-->
<!--            <ref bean="articleProviderFromProperties"/>-->
<!--        </property>-->
<!--    </bean>-->


</beans>
