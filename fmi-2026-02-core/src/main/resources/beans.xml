    <bean id="articleRepoInMemory" class="course.spring.dao.impl.ArticleRepositoryInMemory"
          c:idGen-ref="longIdGen" />
    <bean id="atricleProviderFactory" class="course.spring.service.impl.ArticleProviderFactory"
          c:articlesRepo-ref="articleRepoInMemory" />
    <bean id="articleProviderInMemory" class="course.spring.service.impl.ArticleProviderInMemory"
          factory-bean="atricleProviderFactory" factory-method="createArticleProvider" />
    <bean id="articleProviderFromProperties" class="course.spring.service.impl.ArticleProviderFromProperties"
          p:articleTitles="${articles.titles}" />
